{
  "name": "tiggys-play",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "npm run check:assets && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check:assets": "node scripts/verify-assets.mjs",
    "prebuild": "node scripts/export-voice-library.mjs",
    "test:voice-provider": "node --test scripts/elevenlabs-client.test.mjs",
    "prepare:rig": "python3 scripts/prepare-rive-source.py",
    "prepare:character": "python3 scripts/export-character-layers.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
